# Frontend (Vite, safe to expose — anon key only, never the service role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Function secrets (Supabase Dashboard > Edge Functions > Secrets).
# NEVER prefix these with VITE_ and never commit real values.
IPROG_SMS_API_TOKEN=your-iprogsms-api-token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public URL of this app, used in SMS action links: https://<app-domain>/action/<token>
APP_PUBLIC_URL=https://air.adamson.edu.ph
# Offline threshold: a device counts as OFFLINE when its newest reading is
# older than this. It is deliberately NOT an environment variable: the value
# lives in supabase/functions/_shared/offline_config.ts (default 3 minutes,
# floor 2 minutes) and the dashboard imports the same file, so the room cards
# and the offline SMS can never disagree. Change it there, not here.
# SMS cooldown per notification (seconds, default 600 = 10 min). Escalation bypasses.
SMS_COOLDOWN_S=600
# Optional: Database webhook -> air-alerts bearer token (empty = open).
SMS_ALERT_WEBHOOK_SECRET=
